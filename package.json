{
  "name": "restaurantos",
  "productName": "RestaurantOS",
  "version": "1.0.8",
  "description": "Enterprise Offline-First Windows Desktop POS for Restaurants",
  "author": "RestaurantOS",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.restaurantos.pos",
    "productName": "RestaurantOS",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/prebuilds/win32-x64.node"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "sync/**/*",
      "printing/**/*",
      "reports/**/*",
      "backup/**/*",
      "updater/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MuhammadAbulubabaAttari2526",
        "repo": "restaurentos"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RestaurantOS"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "api": "node server/index.js",
    "api:dev": "node --watch server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build && electron .",
    "dist:win": "npm run build && npm run verify:sqlite && electron-builder --win nsis --x64",
    "dist:win:unpacked": "npm run build && npm run verify:sqlite && electron-builder --win --x64 --dir",
    "release:win": "npm run build && npm run verify:sqlite && electron-builder --win nsis --x64 --publish always",
    "postinstall": "node scripts/verify-sqlite-native.cjs",
    "verify:sqlite": "node scripts/verify-sqlite-native.cjs",
    "test": "vitest run",
    "test:electron": "electron test-electron-headless.cjs",
    "test:watch": "vitest",
    "provision-owner": "node functions/scripts/provision-first-owner.js",
    "set-password": "node functions/scripts/set-account-password.js",
    "migrate:firestore": "node functions/scripts/migrate-firestore-to-mongo.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.49.0",
    "mongodb": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wait-on": "^9.5.1"
  }
}
