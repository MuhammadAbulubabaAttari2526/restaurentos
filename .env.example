# ─── FRONTEND (Vercel) ───────────────────────────────────────────────────────
# Set this to your Render backend URL e.g. https://restaurantos-api.onrender.com
VITE_API_BASE_URL=
VITE_CURRENCY=PKR

# ─── BACKEND (Render) ────────────────────────────────────────────────────────
# Server-side only. NEVER rename to VITE_MONGODB_* (would expose secrets to browser)
MONGODB_URI=
MONGODB_DB=restaurantos

# Allowed frontend origin for CORS (set to your Vercel URL)
CORS_ORIGIN=

# Port for the API server (Render sets this automatically)
PORT=8787
